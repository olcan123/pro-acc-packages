{
  "name": "@pro-acc/ui",
  "version": "0.1.0",
  "description": "Pro-Acc Nuxt module: registers @pro-acc/ui-vue components for Nuxt (same auto-import names) and ships the POS interface",
  "keywords": [
    "erp",
    "form",
    "nuxt",
    "pos",
    "pro-acc",
    "ui",
    "vue"
  ],
  "homepage": "https://github.com/olcan123/pro-acc-packages/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/olcan123/pro-acc-packages/issues"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olcan123/pro-acc-packages.git",
    "directory": "packages/ui"
  },
  "files": [
    "module.mjs",
    "module.d.ts",
    "runtime",
    "README.md",
    "DESIGN.md"
  ],
  "type": "module",
  "main": "./module.mjs",
  "types": "./module.d.ts",
  "exports": {
    ".": {
      "types": "./module.d.ts",
      "import": "./module.mjs"
    },
    "./pos/*": "./runtime/pos/*",
    "./styles.css": "./runtime/styles/ui.css",
    "./package.json": "./package.json",
    "./error-page": "./runtime/error.vue",
    "./pos/composables/useCashCount": "./runtime/pos/composables/useCashCount.js",
    "./pos/composables/useCashCount.js": "./runtime/pos/composables/useCashCount.js",
    "./pos/composables/usePaymentKeypad": "./runtime/pos/composables/usePaymentKeypad.js",
    "./pos/composables/usePaymentKeypad.js": "./runtime/pos/composables/usePaymentKeypad.js",
    "./pos/composables/usePaymentSplit": "./runtime/pos/composables/usePaymentSplit.js",
    "./pos/composables/usePaymentSplit.js": "./runtime/pos/composables/usePaymentSplit.js",
    "./pos/composables/usePosHotkeys": "./runtime/pos/composables/usePosHotkeys.js",
    "./pos/composables/usePosHotkeys.js": "./runtime/pos/composables/usePosHotkeys.js",
    "./pos/composables/useSessionSync": "./runtime/pos/composables/useSessionSync.js",
    "./pos/composables/useSessionSync.js": "./runtime/pos/composables/useSessionSync.js",
    "./pos/composables/useTerminalName": "./runtime/pos/composables/useTerminalName.js",
    "./pos/composables/useTerminalName.js": "./runtime/pos/composables/useTerminalName.js",
    "./pos/stores/auth.store": "./runtime/pos/stores/auth.store.js",
    "./pos/stores/auth.store.js": "./runtime/pos/stores/auth.store.js",
    "./pos/stores/cart.store": "./runtime/pos/stores/cart.store.js",
    "./pos/stores/cart.store.js": "./runtime/pos/stores/cart.store.js",
    "./pos/stores/product.store": "./runtime/pos/stores/product.store.js",
    "./pos/stores/product.store.js": "./runtime/pos/stores/product.store.js",
    "./pos/stores/session.store": "./runtime/pos/stores/session.store.js",
    "./pos/stores/session.store.js": "./runtime/pos/stores/session.store.js",
    "./pos/stores/settings.store": "./runtime/pos/stores/settings.store.js",
    "./pos/stores/settings.store.js": "./runtime/pos/stores/settings.store.js",
    "./pos/stores/terminal.store": "./runtime/pos/stores/terminal.store.js",
    "./pos/stores/terminal.store.js": "./runtime/pos/stores/terminal.store.js",
    "./pos.css": "./runtime/styles/pos.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node --test tests/package.test.mjs",
    "test": "node --test tests/package.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.0",
    "@nuxt/schema": "^4.6.0",
    "@pro-acc/ui-vue": "^0.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.2.2",
    "primeicons": "^7.0.0",
    "tailwindcss": "^4.2.2"
  },
  "peerDependencies": {
    "@nuxtjs/i18n": "^10.0.0",
    "@pinia/nuxt": "^0.11.0",
    "nuxt": "^4.0.0",
    "nuxt-toast": "^1.4.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.0.0 || ^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
